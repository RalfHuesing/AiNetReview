{
  "schemaVersion": 1,
  "solution": "AiNetReview.slnx",
  "outputDirectory": "audit-reporting",
  "analyses": {
    "method-control-flow-outliers": {
      "enabled": true,
      "percentile": 90
    },
    "dead-code-candidates": {
      "enabled": true
    },
    "duplicate-code-candidates": {
      "enabled": true,
      "minTokens": 30,
      "minimumSimilarity": "exact"
    },
    "non-ascii-identifiers": {
      "enabled": true
    }
  }
}
