root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Technical correctness, dead code, performance, disposal, and async safety.
# (Structural debt rules like MA0051 line length, CA1502/CA1505 complexity, CA1506 coupling are omitted.)

# Design: Sealed classes as mandated by Epic 4 ("Konkrete Regeln und Dienste sind standardmäßig sealed.")
dotnet_diagnostic.MA0053.severity = error

# Dead code and logic flaws
dotnet_diagnostic.CA1508.severity = error

# Performance and enumeration
dotnet_diagnostic.CA1851.severity = warning
dotnet_diagnostic.CA1849.severity = error

# Resource and memory safety
dotnet_diagnostic.CA2000.severity = error
dotnet_diagnostic.CA2012.severity = error
dotnet_diagnostic.MA0025.severity = error

# Async, cancellation, and task handling
dotnet_diagnostic.MA0040.severity = error
dotnet_diagnostic.MA0042.severity = error
dotnet_diagnostic.MA0045.severity = warning
dotnet_diagnostic.MA0064.severity = error
dotnet_diagnostic.MA0134.severity = error
dotnet_diagnostic.MA0155.severity = error

# Security
dotnet_diagnostic.MA0009.severity = error

# I/O correctness
dotnet_diagnostic.MA0060.severity = error

# String & API best practices ("nimm besser string.foo statt string.bar")
dotnet_diagnostic.MA0035.severity = error
dotnet_diagnostic.MA0079.severity = error

# Test projects: relax constraints that only apply to production boundaries
[tests/**/*.cs]
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.MA0040.severity = suggestion
dotnet_diagnostic.MA0042.severity = suggestion
dotnet_diagnostic.MA0045.severity = suggestion
dotnet_diagnostic.MA0009.severity = suggestion
dotnet_diagnostic.CA1849.severity = suggestion

[**/*.g.cs]
generated_code = true

[**/obj/**.cs]
generated_code = true

[**/bin/**.cs]
generated_code = true
